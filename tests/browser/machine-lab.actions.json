[
  ["until", "window.__machineLab?.ready", 10000],
  ["eval", "(()=>{const s=window.__machineLab.stats();if(!s.webgl||s.playing||s.rpm!==24)throw Error(JSON.stringify(s));return s;})()"],
  ["shot", "shots/machine-lab-overview.png", ".workbench"],
  ["scroll", "[data-angle='180']"],
  ["click", "[data-angle='180']"],
  ["eval", "(()=>{const s=window.__machineLab.stats();if(Math.abs(s.model.travel-.08)>1e-10||Math.abs(s.model.velocity)>1e-10||s.playing)throw Error('dead centre');return s.model;})()"],
  ["scroll", "#play"],
  ["click", "#play"],
  ["wait", 300],
  ["eval", "(()=>{const s=window.__machineLab.stats();if(!s.playing||s.angle===Math.PI)throw Error('playback');return {playing:s.playing,angle:s.angle};})()"],
  ["scroll", "#angle"],
  ["key", "ArrowRight", "#angle"],
  ["eval", "(()=>{if(window.__machineLab.stats().playing)throw Error('seek must pause');window.__machineLab.seek(90);const r=document.querySelector('#reveal');r.value='.5';r.dispatchEvent(new Event('input',{bubbles:true}));return true;})()"],
  ["scroll", "#machine"],
  ["shot", "shots/machine-lab-partly-revealed.png", ".workbench"],
  ["eval", "(()=>{const r=document.querySelector('#reveal');r.value='1';r.dispatchEvent(new Event('input',{bubbles:true}));return true;})()"],
  ["scroll", "#frame"],
  ["click", "#frame"],
  ["wait", 550],
  ["eval", "(()=>{const s=window.__machineLab.stats();if(s.reveal!==1||s.scene.guardZ!==91||Math.abs(s.model.rodLength-.14)>1e-12)throw Error('reveal');return s.scene;})()"],
  ["shot", "shots/machine-lab-revealed.png", ".workbench"],
  ["scroll", "[data-part='rod']"],
  ["click", "[data-part='rod']"],
  ["click", "#focus-part"],
  ["wait", 600],
  ["eval", "(()=>{if(window.__machineLab.stats().selected!=='rod')throw Error('inspection');return true;})()"],
  ["scroll", "#machine"],
  ["shot", "shots/machine-lab-closeup.png", ".workbench"],
  ["eval", "window.__machineCamera=window.__machineLab.stats().scene.camera.position"],
  ["drag", "#machine", 0.5, 0.5, 0.66, 0.42, 12],
  ["eval", "(()=>{const s=window.__machineLab.stats();if(JSON.stringify(s.scene.camera.position)===JSON.stringify(window.__machineCamera)||s.playing)throw Error('camera inspection');return true;})()"],
  ["key", "ArrowRight", "#machine"],
  ["scroll", "#reset"],
  ["click", "#reset"],
  ["wait", 550],
  ["eval", "(()=>{const s=window.__machineLab.stats();if(s.playing||s.reveal!==0||s.rpm!==24||s.selected!=='crank'||Math.abs(s.angle-Math.PI/4)>1e-10||s.scene.guardZ!==16)throw Error('reset');if(document.documentElement.scrollWidth>innerWidth)throw Error('horizontal overflow');return {reset:true,reducedMotion:s.reducedMotion,drawCalls:s.scene.drawCalls};})()"],
  ["shot", "shots/machine-lab-reset.png", ".workbench"]
]

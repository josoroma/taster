[
  ["until", "window.__arduinoLab?.ready", 10000],
  ["eval", "(()=>{const s=window.__arduinoLab.stats();if(s.playing||s.config.project!=='lighthouse'||s.model.pwm!==204||s.model.buttonRead!=='HIGH')throw Error(JSON.stringify(s));return {ready:s.ready,reducedMotion:s.reducedMotion};})()"],
  ["shot", "shots/arduino-lab-overview.png", ".spark-stage"],
  ["scroll", "#play"],
  ["click", "#play"],
  ["wait", 200],
  ["eval", "(()=>{const s=window.__arduinoLab.stats();if(!s.playing||s.elapsedMs<=0)throw Error('playback did not advance');return {playing:s.playing,elapsed:s.elapsedMs};})()"],
  ["click", "#play"],
  ["eval", "window.__arduinoLab.seek(800)"],
  ["eval", "(()=>{const s=window.__arduinoLab.stats();if(s.playing||s.model.pwm!==0)throw Error('half-cycle must be off');return true;})()"],
  ["click", "#reset"],
  ["click", "#step"],
  ["eval", "(()=>{if(window.__arduinoLab.stats().elapsedMs!==250)throw Error('step');return true;})()"],
  ["scroll", "[data-project='signal']"],
  ["click", "[data-project='signal']"],
  ["eval", "(()=>{if(!document.querySelector('#cycle').disabled)throw Error('signal timer should be disabled');const b=document.querySelector('#hold-button');b.focus();b.dispatchEvent(new KeyboardEvent('keydown',{key:' ',bubbles:true}));const s=window.__arduinoLab.stats();if(!s.pressed||s.model.buttonRead!=='LOW'||s.model.pwm!==204)throw Error('active-low held button');b.dispatchEvent(new KeyboardEvent('keyup',{key:' ',bubbles:true}));if(window.__arduinoLab.stats().model.pwm!==0)throw Error('released button');return {held:s.model};})()"],
  ["scroll", "#hold-button"],
  ["key", "Enter", "#hold-button"],
  ["eval", "(()=>{if(window.__arduinoLab.stats().pressed)throw Error('keyboard release stuck');return true;})()"],
  ["scroll", "[data-project='firefly']"],
  ["click", "[data-project='firefly']"],
  ["eval", "(()=>{const cycle=document.querySelector('#cycle');cycle.value='2200';cycle.dispatchEvent(new Event('input',{bubbles:true}));const knob=document.querySelector('#knob');knob.value='1023';knob.dispatchEvent(new Event('input',{bubbles:true}));window.__arduinoLab.seek(1100);const s=window.__arduinoLab.stats();if(s.model.pwm!==255||s.config.cycleMs!==2200||!s.sketch.includes('CYCLE_MS = 2200UL'))throw Error('firefly peak or sketch');return s.model;})()"],
  ["shot", "shots/arduino-lab-firefly.png", ".spark-stage"],
  ["scroll", "#prediction"],
  ["click", "input[name='prediction'][value='peak']"],
  ["click", ".check-answer"],
  ["eval", "(()=>{if(!document.querySelector('#prediction-feedback').textContent.startsWith('You got it.'))throw Error('prediction feedback');if(window.__arduinoLab.stats().model.pwm!==255)throw Error('prediction preview');return true;})()"],
  ["scroll", "[data-part='button']"],
  ["click", "[data-part='button']"],
  ["eval", "(()=>{if(window.__arduinoLab.stats().selectedPart!=='button'||!document.querySelector('#part-copy').textContent.includes('LOW'))throw Error('inspection');return true;})()"],
  ["scroll", "[data-wire='led']"],
  ["click", "[data-wire='led']"],
  ["click", "[data-wire='button']"],
  ["click", "[data-wire='knob']"],
  ["eval", "(()=>{if(window.__arduinoLab.stats().wiring!==3)throw Error('wiring checklist');return true;})()"],
  ["eval", "(()=>{const input=document.querySelector('#invention-name');input.value='Cave beacon';input.dispatchEvent(new Event('input',{bubbles:true}));const original=URL.createObjectURL;URL.createObjectURL=function(blob){blob.text().then(text=>window.__sparkDownloaded=text);return original.call(URL,blob);};return true;})()"],
  ["scroll", "#download"],
  ["click", "#download"],
  ["until", "window.__sparkDownloaded", 2000],
  ["eval", "(()=>{const s=window.__arduinoLab.stats();if(window.__sparkDownloaded!==s.sketch||s.filename!=='cave_beacon.ino')throw Error('download differs from preview');return {download:s.filename,bytes:s.sketch.length};})()"],
  ["scroll", "#reset"],
  ["click", "#reset"],
  ["eval", "(()=>{const s=window.__arduinoLab.stats();if(s.playing||s.elapsedMs!==0||s.pressed||s.knob!==820||s.config.cycleMs!==1600||s.model.pwm!==0)throw Error('reset');if(document.documentElement.scrollWidth>innerWidth)throw Error('horizontal overflow');return {reset:true,reducedMotion:s.reducedMotion};})()"],
  ["shot", "shots/arduino-lab-reset.png", ".spark-stage"]
]

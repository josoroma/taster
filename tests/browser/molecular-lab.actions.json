[
  [
    "until",
    "window.__molecularLab?.ready",
    10000
  ],
  [
    "eval",
    "(()=>{const s=window.__molecularLab.stats();if(!s.webgl||s.atomCount!==327||s.residueCount!==46)throw Error(JSON.stringify(s));return {ready:true,measurements:s.measurements};})()"
  ],
  [
    "scroll",
    "[data-mode='atoms']"
  ],
  [
    "click",
    "[data-mode='atoms']"
  ],
  [
    "eval",
    "(()=>{const s=window.__molecularLab.stats();if(s.representation!=='atoms'||s.scene.atomCount!==327)throw Error('atomic representation');return s.representation;})()"
  ],
  [
    "shot",
    "/tmp/molecular-atoms.png",
    ".workbench"
  ],
  [
    "scroll",
    "[data-residue='A:26']"
  ],
  [
    "click",
    "[data-residue='A:26']"
  ],
  [
    "eval",
    "(()=>{if(window.__molecularLab.stats().selected!=='A:26'||!document.querySelector('[data-residue=\"A:16\"]').classList.contains('partner'))throw Error('sequence mapping');return document.querySelector('#residue-note').textContent;})()"
  ],
  [
    "scroll",
    "[data-bridge='A:4-A:32']"
  ],
  [
    "click",
    "[data-bridge='A:4-A:32']"
  ],
  [
    "wait",
    800
  ],
  [
    "eval",
    "(()=>{const s=window.__molecularLab.stats();if(s.selected!=='A:4'||s.stageIndex!==2||s.representation!=='ribbon')throw Error('bridge focus');return s.scene.camera;})()"
  ],
  [
    "shot",
    "/tmp/molecular-bridge.png",
    ".workbench"
  ],
  [
    "eval",
    "window.__molecularLab.seek(7.9)"
  ],
  [
    "scroll",
    "#play"
  ],
  [
    "click",
    "#play"
  ],
  [
    "wait",
    450
  ],
  [
    "eval",
    "(()=>{const s=window.__molecularLab.stats();if(s.stageIndex!==1||s.representation!=='atoms'||!s.transport.playing)throw Error('playback boundary');return s.transport;})()"
  ],
  [
    "scroll",
    "#molecule"
  ],
  [
    "eval",
    "window.__molecularBeforeCamera=window.__molecularLab.stats().scene.camera.position"
  ],
  [
    "drag",
    "#molecule",
    0.5,
    0.5,
    0.65,
    0.4,
    12
  ],
  [
    "eval",
    "(()=>{const s=window.__molecularLab.stats();if(s.transport.playing||JSON.stringify(s.scene.camera.position)===JSON.stringify(window.__molecularBeforeCamera))throw Error(\"pointer interruption\");return {pointerOrbit:true};})()"
  ],
  [
    "key",
    "ArrowRight",
    "#molecule"
  ],
  [
    "eval",
    "(()=>{if(window.__molecularLab.stats().transport.playing)throw Error('camera did not pause');window.__molecularLab.seek(20);const select=document.querySelector('#speed');select.value='-1';select.dispatchEvent(new Event('change',{bubbles:true}));return true;})()"
  ],
  [
    "scroll",
    "#play"
  ],
  [
    "click",
    "#play"
  ],
  [
    "wait",
    350
  ],
  [
    "eval",
    "(()=>{const s=window.__molecularLab.stats();if(s.transport.time>=20||s.transport.rate!==-1)throw Error('reverse playback');return s.transport;})()"
  ],
  [
    "scroll",
    "#reset"
  ],
  [
    "click",
    "#reset"
  ],
  [
    "wait",
    750
  ],
  [
    "eval",
    "(()=>{const s=window.__molecularLab.stats();if(s.selected!=='A:3'||s.transport.time!==0||s.transport.playing||s.representation!=='ribbon')throw Error('reset');if(document.documentElement.scrollWidth>innerWidth)throw Error('horizontal overflow');return {reset:true,reducedMotion:s.reducedMotion,drawCalls:s.scene.drawCalls};})()"
  ],
  [
    "shot",
    "/tmp/molecular-overview.png",
    ".workbench"
  ]
]
